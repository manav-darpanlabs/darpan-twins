# LLM Provider Configuration
# Choose your LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# LLM Model Selection
# OpenAI options: gpt-4o, gpt-4o-mini (recommended for cost), gpt-4-turbo, gpt-3.5-turbo
# Anthropic options: claude-sonnet-3-5, claude-opus-3, claude-haiku-3
LLM_MODEL=gpt-4o-mini

# OpenAI API Key (required if using OpenAI)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API Key (required if using Anthropic/Claude)
# Get your key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# RAG Configuration
# Path to RAG examples database (generated by build_rag_examples.py)
RAG_EXAMPLES_PATH=data/rag_examples.json

# Path to cached embeddings (auto-generated on first run)
RAG_EMBEDDING_CACHE=data/rag_embeddings.npy

# Number of similar past decisions to retrieve for context
RAG_K_NEIGHBORS=10

# Optional: Streamlit Configuration
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=localhost
